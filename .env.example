# Lead forms post here (Formspree / Web3Forms endpoint URL). Leave empty to show a "not configured" notice.
PUBLIC_FORM_ENDPOINT=
# Only for Web3Forms: your access key (endpoint https://api.web3forms.com/submit). Leave empty for Formspree.
PUBLIC_FORM_ACCESS_KEY=
# Chat API URL (AWS Lambda function URL). Empty = widget shows the contact fallback.
PUBLIC_CHAT_ENDPOINT=
