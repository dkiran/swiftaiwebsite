# Copy to /etc/swiftai-api.env on the server (sudo nano /etc/swiftai-api.env), then:
#   sudo chown root:swiftai /etc/swiftai-api.env && sudo chmod 640 /etc/swiftai-api.env
# NEVER commit the real file. Secrets live only on the server.

# Where the API listens. Keep it on localhost; nginx forwards /api/ to it.
PORT=3100
HOST=127.0.0.1
TRUST_PROXY=1

# MySQL (a dedicated database and a least-privilege user, see docs/deployment.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=swiftai
DB_PASSWORD=change-me
DB_NAME=swiftai

# ZeptoMail (leave ZEPTOMAIL_TOKEN empty to store forms without sending email)
ZEPTOMAIL_TOKEN=
# api.zeptomail.com for the global data centre, api.zeptomail.in for India, api.zeptomail.eu for the EU
ZEPTOMAIL_API_HOST=api.zeptomail.in
MAIL_FROM_ADDRESS=hello@swift-ai.in
MAIL_FROM_NAME=Swift AI
# Who receives new-submission notifications
NOTIFY_EMAIL=hello@swift-ai.in

# Chat assistant (leave the key empty to switch the assistant off: the widget then shows a contact message)
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
ALLOWED_ORIGIN=https://swift-ai.in
# CHAT_DISABLED=1
