# systemd unit for the Swift AI API. Install: sudo cp deploy/swiftai-api.service /etc/systemd/system/swiftai-api.service
# Then: sudo systemctl daemon-reload && sudo systemctl enable --now swiftai-api
[Unit]
Description=Swift AI API (forms and chat)
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=swiftai
Group=swiftai
WorkingDirectory=/opt/swiftai-api
EnvironmentFile=/etc/swiftai-api.env
ExecStart=/usr/bin/node /opt/swiftai-api/main.mjs
Restart=always
RestartSec=3
# basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
