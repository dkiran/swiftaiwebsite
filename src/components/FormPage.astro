---
import Base from '../layouts/Base.astro';
interface Props { title: string; description: string; path: string; eyebrow: string; heading: string; lead: string; points: string[]; }
const { title, description, path, eyebrow, heading, lead, points } = Astro.props;
---
<Base title={title} description={description} path={path}>
  <section class="section" style="padding-top:clamp(48px,8vw,96px)">
    <div class="container calc" style="align-items:start">
      <div class="reveal">
        <span class="eyebrow">{eyebrow}</span>
        <h1 style="font-size:clamp(2.2rem,5vw,3.75rem)" set:html={heading} />
        <p class="lead" style="margin:20px 0 28px">{lead}</p>
        <ul class="checks">{points.map((p) => <li>{p}</li>)}</ul>
        <slot name="aside" />
      </div>
      <div class="reveal d1"><slot /></div>
    </div>
  </section>
</Base>
