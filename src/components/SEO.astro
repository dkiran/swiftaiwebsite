---
import { site, founder } from '../data/site';
interface Props { title: string; description: string; path: string; ogType?: 'website' | 'article'; schema?: object[]; noindex?: boolean; }
const { title, description, path, ogType = 'website', schema = [], noindex = false } = Astro.props;
const fullTitle = path === '/' ? title : `${title} | ${site.name}`;
const canonical = new URL(path, site.url).href;
const og = new URL('/og-default.png', site.url).href;
const base = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': `${site.url}/#org`, name: site.name, legalName: site.legalName, url: site.url,
    logo: `${site.url}/favicon.svg`, description: site.tagline, slogan: site.slogan, areaServed: 'Worldwide',
    ...(founder.name ? { founder: { '@type': 'Person', name: founder.name, jobTitle: founder.title } } : {}),
    sameAs: Object.values(site.social).filter(Boolean),
    taxID: site.gstin, telephone: site.phoneHref,
    address: [site.office, site.registered].map((a) => ({ '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.locality, addressRegion: a.region, postalCode: a.postalCode, addressCountry: 'IN' })),
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: site.email, telephone: site.phoneHref, areaServed: 'Worldwide', availableLanguage: ['en'] } },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': `${site.url}/#org` } },
];
const all = [...base, ...schema];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />
{all.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
