---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';
const schema = [breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]),
  { '@context': 'https://schema.org', '@type': 'AboutPage', url: `${site.url}/about/`, about: { '@id': `${site.url}/#org` } }];
---
<Base title="About Swift AI Tech Solutions Private Limited"
  description="Swift AI Tech Solutions Private Limited is an Indian company building AI automations, fractional CTO services, software and products."
  path="/about/" schema={schema}>
  <section class="hero"><div class="container"><span class="pill">About us</span><h1>Technology that makes <span class="gradient">business faster.</span></h1>
    <p class="lead">We help Indian businesses use AI and strong engineering leadership to do more with the people they have.</p></div></section>
  <section class="section alt"><div class="container"><div class="prose reveal">
    <h2>Who we are</h2>
    <p>Swift AI is the brand of <strong>{site.legalName}</strong>, a private limited company registered in India. We work with SMEs, MSMEs and startups on four things: AI automations, fractional and full-time CTO leadership, fast software development, and our own products, <a href={site.products.singleqr} rel="noopener">SingleQR</a> and <a href={site.products.singlestaff} rel="noopener">SingleStaff</a>.</p>
    <h2>What we believe</h2>
    <ul><li><b>Understand before building.</b> Technology should start from the business problem.</li>
      <li><b>Speed is a feature.</b> Shorter cycles reduce risk and cost.</li>
      <li><b>Honest advice.</b> If something isn't worth automating or building, we say so.</li>
      <li><b>People stay in charge.</b> AI does the repetitive work, humans make the important decisions.</li></ul>
    <h2>The CTO network</h2>
    <p>We are building a network of experienced CTOs so that startups, SMEs and larger companies can find technology leadership, fractionally or full-time. Experienced CTOs can <a href="/join-as-a-cto/">apply to join</a>, and companies can <a href="/hire-a-cto/">request a CTO</a>.</p>
    <h2>Company details</h2>
    <p>{site.legalName}<br />{site.address}<br />{site.cin}<br />{site.gst}<br />Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div></div></section>
  <CTA />
</Base>
