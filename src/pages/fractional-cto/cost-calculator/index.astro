---
import Base from '../../../layouts/Base.astro';
import CTA from '../../../components/CTA.astro';
import FAQ from '../../../components/FAQ.astro';
import { site } from '../../../data/site';
import { breadcrumbSchema } from '../../../lib/schema';
const faqs = [
  { q: 'How much does a fractional CTO cost in India?', a: 'Swift AI charges ₹1,500 per hour for fractional CTO time, and early-stage startups can start from ₹850 per hour depending on scope. This calculator turns your hours per week and duration into an indicative monthly and total range, and compares it with the yearly cost of a full-time CTO. It is an estimate, not a quote.' },
  { q: 'Is a fractional CTO cheaper than a full-time CTO?', a: 'Usually yes for early-stage companies, because you pay only for the hours you need and carry no long-term salary commitment. As the workload grows toward full-time, the gap narrows.' },
];
const schema = [breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Fractional CTO', path: '/fractional-cto/' }, { name: 'Cost calculator', path: '/fractional-cto/cost-calculator/' }]),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Fractional CTO Cost Calculator', url: `${site.url}/fractional-cto/cost-calculator/`, applicationCategory: 'BusinessApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' }, publisher: { '@id': `${site.url}/#org` } }];
---
<Base title="Fractional CTO Cost Calculator (India, ₹)"
  description="Estimate what a fractional CTO costs for your startup or SME in India at ₹850–₹1,500 per hour, and compare it with a full-time CTO."
  path="/fractional-cto/cost-calculator/" schema={schema}>
  <section class="section" style="padding-top:clamp(48px,8vw,96px)"><div class="container">
    <div class="head reveal"><span class="eyebrow">Free tool</span><h1 style="font-size:clamp(2.2rem,5vw,3.75rem)">Fractional CTO <span class="gradient">cost calculator.</span></h1>
      <p class="lead">Choose your stage, hours and duration to see an indicative monthly and total cost, and how it compares with a full-time CTO. See <a href="/pricing/">our rates</a>.</p></div>
    <div class="calc" id="cto-calc">
      <div class="form">
        <div class="field"><label for="stage">Company stage</label><select id="stage"><option value="idea">Idea stage (startup rate)</option><option value="mvp" selected>Building MVP / early users (startup rate)</option><option value="scaling">Scaling / established (standard rate)</option></select></div>
        <div class="field"><label for="hours">Hours per week: <b id="hours-v">10</b></label><input id="hours" type="range" min="2" max="40" value="10" /></div>
        <div class="field"><label for="months">Duration: <b id="months-v">6</b> months</label><input id="months" type="range" min="1" max="24" value="6" /></div>
        <p class="form-note">Rates: ₹1,500 per hour standard; early-stage startups from ₹850 per hour depending on scope.</p>
      </div>
      <div class="result" aria-live="polite">
        <small>Indicative monthly cost</small>
        <div class="big" id="monthly">–</div>
        <hr />
        <div class="range-row"><span>Total over <span id="m2">6</span> months</span><b id="total">–</b></div>
        <div class="range-row" style="margin-top:10px"><span>Full-time CTO, per year*</span><b id="ft">–</b></div>
        <p id="verdict" style="margin-top:18px"></p>
        <a class="btn btn-primary" href="/hire-a-cto/" style="width:100%">Hire a CTO</a>
        <p style="font-size:.8rem;margin:14px 0 0">Indicative estimate, not a quote. *The full-time figure is a rough market benchmark, not a Swift AI price. Taxes as applicable.</p>
      </div>
    </div>
  </div></section>
  <section class="section alt"><div class="container"><div class="head center"><h2>Common questions</h2></div><FAQ items={faqs} /></div></section>
  <CTA title="Want an exact figure?" sub="Tell us what you need and we'll recommend the right engagement and a fixed monthly price." href="/hire-a-cto/" label="Request a CTO" />
</Base>
<script>
  import { estimateCto, inr } from '../../../lib/calc';
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const run = () => {
    const v = { stage: $('stage').value, hoursPerWeek: +$('hours').value, months: +$('months').value } as Parameters<typeof estimateCto>[0];
    const r = estimateCto(v);
    $('hours-v').textContent = String(v.hoursPerWeek); $('months-v').textContent = String(v.months); $('m2').textContent = String(v.months);
    $('monthly').textContent = r.monthlyMin === r.monthlyMax ? inr(r.monthlyMax) : `${inr(r.monthlyMin)} – ${inr(r.monthlyMax)}`;
    $('total').textContent = r.totalMin === r.totalMax ? inr(r.totalMax) : `${inr(r.totalMin)} – ${inr(r.totalMax)}`;
    $('ft').textContent = inr(r.fullTimeYearly);
    const fractionalYear = r.monthlyMax * 12;
    $('verdict').textContent = fractionalYear < r.fullTimeYearly
      ? `At this level a fractional CTO costs at least ${Math.round((1 - fractionalYear / r.fullTimeYearly) * 100)}% less per year than a full-time CTO (based on the top of the range).`
      : 'At this many hours, a full-time CTO may be the better value. Talk to us about the right setup.';
  };
  document.querySelectorAll('#cto-calc input, #cto-calc select').forEach((e) => e.addEventListener('input', run));
  run();
</script>
