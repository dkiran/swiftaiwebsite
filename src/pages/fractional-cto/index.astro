---
import Base from '../../layouts/Base.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';
const faqs = [
  { q: 'What is a fractional CTO?', a: 'A fractional CTO is an experienced chief technology officer who works with your company for a fixed part of their time, for example one or two days a week. They own technology strategy, architecture, hiring and delivery, without the cost of a full-time executive.' },
  { q: 'When should a startup hire a fractional CTO?', a: 'When you need senior technical leadership but not yet a full-time CTO: before building the first product, when an outsourced build needs oversight, when the engineering team lacks direction, or when you are preparing for fundraising and technical due diligence.' },
  { q: 'How much does a fractional CTO cost?', a: 'Cost depends on hours per week, seniority and whether the role is advisory or hands-on. Use our cost calculator for an indicative monthly range and a comparison with a full-time CTO.' },
  { q: 'Can a fractional CTO become full-time later?', a: 'Yes. Many engagements start part-time and convert to a full-time role as the company grows, or the fractional CTO helps you recruit and hand over to your permanent CTO.' },
  { q: 'I am not technical. Is this right for me?', a: 'It is especially useful for non-technical founders. Your CTO translates business goals into technical plans, evaluates vendors and developers on your behalf, and keeps you from costly mistakes.' },
];
const schema = [serviceSchema('Fractional CTO Services', 'Part-time and full-time CTO leadership for startups and SMEs worldwide.', '/fractional-cto/'),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Fractional CTO', path: '/fractional-cto/' }])];
---
<Base title="Fractional CTO Services for Startups and SMEs"
  description="Hire an experienced fractional CTO from Swift AI: technology strategy, architecture, hiring and delivery, part-time or full-time."
  path="/fractional-cto/" schema={schema}>
  <ServiceHero eyebrow="Fractional CTO" title="A CTO for your company, <span class='gradient'>without the full-time cost.</span>"
    lead="Senior technology leadership for startup founders and SMEs, technical or not. Part-time to start, full-time when you're ready."
    ctaLabel="Hire a CTO" ctaHref="/hire-a-cto/" secondaryLabel="Estimate the cost" secondaryHref="/fractional-cto/cost-calculator/" />

  <section class="section alt"><div class="container">
    <div class="head reveal"><span class="eyebrow">Engagement models</span><h2>Pick the depth you need.</h2></div>
    <div class="grid g3">
      <div class="card reveal"><h3>Advisory</h3><p>A few hours a week. Strategy, architecture reviews, vendor and developer evaluation, and a sounding board for founders.</p></div>
      <div class="card reveal d1"><h3>Hands-on</h3><p>1–3 days a week. Your CTO leads the team day to day: roadmap, code quality, hiring and releases.</p></div>
      <div class="card reveal d2"><h3>Build a team</h3><p>Your CTO recruits and sets up the engineering team and processes, then hands over to a permanent leader.</p></div>
    </div>
  </div></section>

  <section class="section"><div class="container">
    <div class="head reveal"><span class="eyebrow">Your first 30 days</span><h2>What a CTO actually does for you.</h2></div>
    <div class="grid g2">
      <ul class="checks reveal"><li><b>Week 1:</b> understand the business, product and current technology.</li><li><b>Week 2:</b> review architecture, security, costs and delivery risks.</li></ul>
      <ul class="checks reveal d1"><li><b>Week 3:</b> agree a roadmap tied to business goals and a realistic budget.</li><li><b>Week 4:</b> start executing: team, process, vendors and releases.</li></ul>
    </div>
  </div></section>

  <section class="section alt"><div class="container">
    <div class="head center reveal"><span class="eyebrow">CTO Network</span><h2>Matched with experienced CTOs.</h2>
      <p class="lead">We are registering experienced CTOs, so companies of any size can find the right leader, fractionally or full-time.</p></div>
    <div class="btns" style="justify-content:center"><a class="btn btn-primary" href="/hire-a-cto/">Hire a CTO</a><a class="btn btn-ghost" href="/join-as-a-cto/">Join as a CTO</a></div>
  </div></section>

  <section class="section"><div class="container">
    <div class="head center reveal"><span class="eyebrow">Questions</span><h2>Fractional CTO, answered.</h2></div>
    <FAQ items={faqs} />
  </div></section>
  <CTA title="Not sure what you need? Start with a conversation." sub="Tell us about your product and stage. We'll tell you honestly whether a CTO is the right next step." href="/get-started/" label="Request an appointment" />
</Base>
